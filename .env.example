PORT=8080
# ":memory:" = fresh DB seeded on every start (same as the H2 setup). Use a file path to persist.
DB_PATH=:memory:
# Seed sample data on startup (only applied when the DB is empty)
DB_SEED=true
# Audit service. Leave AUDIT_URL empty to disable audit calls (e.g. local dev).
AUDIT_URL=http://internal-audit.prizm.local/api/v2/events
AUDIT_API_KEY=
AUDIT_TIMEOUT_MS=2000
